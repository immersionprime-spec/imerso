# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Imerso

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: URI Postgres (Project Settings → Database). Para `npm run db:verify` / scripts com pooler transacional (6543) funciona; para `npx supabase db query` prefira sessão (5432) ou direct.
# Não commite credenciais; use só em .env.local.
# DATABASE_URL=

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_BUCKET_NAME=splat-viewer

# ===== Luma AI (removido — pipeline local via run-pipeline.ps1) =====
# LUMA_API_KEY=
# LUMA_API_BASE_URL=https://webapp-api.lumalabs.ai/api/v0

# ===== WhatsApp do founder =====
NEXT_PUBLIC_WHATSAPP_FOUNDER=5547999999999
NEXT_PUBLIC_WHATSAPP_MESSAGE_DEFAULT=Olá! Vim do tour virtual e gostaria de mais informações.

# ===== Landing (Sprint 6) =====
# URL completa para iframe na home (ex.: tour público pronto)
# NEXT_PUBLIC_LANDING_DEMO_EMBED_URL=https://app.imerso.com/imobiliaria-slug/tour-slug
# Slug público para botão "Ver exemplo": imobiliaria-slug/tour-slug (sem barra inicial)
# NEXT_PUBLIC_LANDING_DEMO_PATH=demo-imobiliaria/demo-tour
# E-mail exibido no formulário LGPD (mailto)
# NEXT_PUBLIC_CONTACT_EMAIL=contato@imerso.com.br

# ===== Pipeline local → finalize (upload .ksplat sem painel) =====
# Service token longo pro script scripts/local-gs/upload-and-finalize.mjs chamar POST /api/admin/tours/[id]/splat/finalize
# Gere com: openssl rand -hex 32
PIPELINE_SERVICE_TOKEN=

# ===== Tour access (cookies de tour privado) =====
# OBRIGATÓRIA em produção. Em desenvolvimento, SUPABASE_SERVICE_ROLE_KEY é usado como fallback.
# Gere com: openssl rand -hex 32  (Linux/Mac) ou no PowerShell:
#   [System.Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Max 256) }))
# Adicione esta variável nas configurações da Vercel antes do primeiro deploy.
TOUR_ACCESS_SECRET=

# ===== Upstash Redis (rate-limit distribuído em produção) =====
# Crie uma instância gratuita em https://console.upstash.com/
# Copie os valores de: Database → REST API → .env
# Em desenvolvimento sem estas variáveis, o rate-limit usa memória local (OK para dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Limites =====
NEXT_PUBLIC_MAX_VIDEO_SIZE_MB=2048
NEXT_PUBLIC_MULTIPART_CHUNK_SIZE_MB=10
NEXT_PUBLIC_MAX_HOTSPOTS_PER_TOUR=15
